{
  "name": "gaelium-wallet",
  "version": "1.0.2",
  "description": "Gaelium Wallet - Desktop wallet for Gaelium (GAEL) cryptocurrency",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win",
    "build-linux": "electron-builder --linux",
    "build-mac": "electron-builder --mac",
    "build-all": "electron-builder --win --linux"
  },
  "author": {
    "name": "Gaelium Core",
    "email": "contact@gaelium.io"
  },
  "license": "MIT",
  "build": {
    "appId": "io.gaelium.wallet",
    "productName": "Gaelium Wallet",
    "directories": {
      "output": "dist"
    },
    "afterPack": "build/verify-embedded-daemon.js",
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "src/assets/icon.ico",
      "extraResources": [
        { "from": "daemon/gaeliumd-1.0.1.exe", "to": "daemon/gaeliumd.exe" }
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "!**/*.bak*"
    ],
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "icon": "src/assets/icon.png",
      "category": "Finance",
      "extraResources": [
        { "from": "daemon/gaeliumd-linux-1.0.1", "to": "daemon/gaeliumd" }
      ]
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "build/icon.icns",
      "category": "public.app-category.finance",
      "minimumSystemVersion": "14.0",
      "identity": null,
      "extraResources": [
        { "from": "daemon/gaeliumd-mac-1.0.1", "to": "daemon/gaeliumd" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "src/assets/icon.ico",
      "uninstallerIcon": "src/assets/icon.ico",
      "installerHeaderIcon": "src/assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Gaelium Wallet",
      "uninstallDisplayName": "Gaelium Wallet",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true,
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "homepage": "https://gaelium.io"
}